{
  "name": "weather-app",
  "version": "1.0.0",
  "description": "Jednoduchá webová aplikace počasí (lokální)",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "start:local": "node --use-system-ca server.js",
    "dev": "nodemon --exec \"node --use-system-ca\" server.js",
    "start:main": "PORT=3000 node --use-system-ca server.js",
    "dev:main": "PORT=3000 nodemon --exec \"node --use-system-ca\" server.js",
    "start:worktree": "PORT=3001 node --use-system-ca server.js",
    "dev:worktree": "PORT=3001 nodemon --exec \"node --use-system-ca\" server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1",
    "axios": "^1.4.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "multer": "^2.2.0",
    "openai": "^4.102.0"
  }
}
